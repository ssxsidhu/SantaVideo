# Copy to .env and fill in. Never commit .env.

# --- Phase 0 benchmark ---
# fal.ai key (runs Sync lipsync-2/2-pro, LatentSync and Kling LipSync through one account)
FAL_KEY=
# Hard cap for one benchmark run, in USD. Raising it above 20 needs owner approval.
BENCH_BUDGET_USD=20

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_FR=

# --- Later phases (placeholders) ---
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://santa:<POSTGRES_PASSWORD from server ~/santavideo/.env>@127.0.0.1:5433/santa
REDIS_URL=redis://:<REDIS_PASSWORD from server ~/santavideo/.env>@127.0.0.1:6380
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=myvideofromsanta-media
# Test mode only until Phase 5 (live keys are refused unless STRIPE_ALLOW_LIVE=1)
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen --print-secret` (npm run stripe:listen forwards events to localhost)
STRIPE_WEBHOOK_SECRET=
# Optional: set to opt in to Stripe Managed Payments (Stripe as merchant of record); owner decision pending
STRIPE_PRODUCT_TAX_CODE=txcd_10402100
RESEND_API_KEY=

# --- Phase 1 app ---
# 32 random bytes, base64 (encrypts parent emails at rest). Never change it once real orders exist.
DATA_ENCRYPTION_KEY=
SITE_URL=http://localhost:3000
# Local storage for clips/videos until R2 is set up (relative to the repo root)
STORAGE_DIR=.data/storage
# Render worker guardrails: daily vendor cap (USD) and kill switch
RENDER_DAILY_USD_CAP=5
RENDER_PAUSED=0
RENDER_CONCURRENCY=1
# End-card font override
END_CARD_FONT=
# (empty = assets/fonts/GreatVibes-Regular.ttf, SIL OFL)
